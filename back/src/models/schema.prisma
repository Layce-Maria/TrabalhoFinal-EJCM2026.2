// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(cuid())
  member_since DateTime @db.Date
  fistName String
  lastName String
  password String
  phone String
  dataOfBrirth DateTime @db.Date
  gender String


  whishlist Whishlist[]
  cupomId String
  cupom Cupom @relation(fields: [cupomId], references: [id])
  cart Cart?
  reviewsId Review[]
  order Order[]

}

model Cupom{
  id String @id @default(cuid())
  value Float
  code String
  expirationDate DateTime @db.Date
  isActive Boolean @default(true)
  userId User[]
  cartsId Cart[]
  

}

model Product {
  id String @id @default(cuid())
  name String
  description String
  price Float
  rating Float

  variants ProductVariant[]
  whishlist Whishlist[]
  reviewsId Review[]
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])

}

model Category{
  id String @id @default(cuid())
  name String
  products Product[]

}

model Cart{
  id String @id @default(cuid())
  totalPrice Float
  savings Float

  userId String @unique
  user User @relation( fields: [userId], references: [id])
  productsVariants ProductVariant[]
  cupomId String
  cupom Cupom? @relation(fields: [cupomId], references: [id])
}

model ProductVariant{
  id String @id @default(cuid())
  size String
  color String
  stockQuantity Int

  products Product[]
  carts Cart[]
  OrderItens OrderItem[]
}

model Whishlist{
  userId String
  user User @relation(fields: [userId],references: [id])

  productId String
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
}
model Review{
  id String @id @default(cuid())
  rating Float
  comment String?

  userId String
  user User @relation(fields: [userId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
}

model Order{
  id String @id @default(cuid())
  status Boolean
  totalPrice Float
  address String
  placeOn String

  userId String
  user User @relation(fields: [userId], references: [id])
  paymentId Payment[]
  shippingId String @unique
  shipping Shipping @relation("shippingOrder", fields: [shippingId], references: [id])
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
 

}

model Payment{
  id String @id @default(cuid())
  method String
  lastFourDigits String
  ownerName String
  status Boolean
  amount Float



  orderId String
  order Order @relation(fields: [orderId], references: [id])

  

}

model Shipping{
  id String @id @default(cuid())
  ShippingMethod String
  shippingCost Float
  trackingNumber String
  recipientFirstName String
  recipientLastName String
  zipCode String
  streetAddress String
  apartamentSuite String?
  city String
  state String

  order Order? @relation("shippingOrder") 
}

model OrderItem{
  id String @id @default(cuid())
  quantity Int
  unitPrice Float


  OrderId Order?
  variantId String @unique
  variant ProductVariant @relation(fields: [variantId], references: [id])
}